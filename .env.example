# Copy to backend/.env and fill in. Never commit the real .env file.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max (higher = better but slower and more expensive)
ANTHROPIC_EFFORT=medium
# Comma-separated list of origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
