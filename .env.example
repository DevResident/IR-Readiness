# Copy to backend/.env and fill in. Never commit the real .env file.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max (higher = better but slower and more expensive)
ANTHROPIC_EFFORT=medium
# Optional: an Anthropic-compatible gateway instead of api.anthropic.com.
# Example (OpenCode Console, use its API key above and e.g. ANTHROPIC_MODEL=claude-haiku-5-5):
# ANTHROPIC_BASE_URL=https://opencode.ai/inference/anthropic
ANTHROPIC_BASE_URL=
# Optional extra headers for the gateway, as JSON, e.g. {"x-opencode-session": "ses_my-local-dev"}
ANTHROPIC_EXTRA_HEADERS={}
# Comma-separated list of origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
